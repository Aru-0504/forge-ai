# ForgeAI Environment Configuration
# Copy to .env and adjust values for your environment. Never commit secrets.

# Runtime environment: development | staging | production
FORGEAI_ENV=development
FORGEAI_LOG_LEVEL=INFO
FORGEAI_LOG_FORMAT=json

# LLM Provider: stub | ollama | openai_compat
# - Local unattended review: FORGEAI_LLM_PROVIDER=ollama (e.g., qwen2.5:7b-instruct)
# - Hosted free-tier deploy: FORGEAI_LLM_PROVIDER=openai_compat (e.g., Groq/OpenRouter open model)
FORGEAI_LLM_PROVIDER=stub
FORGEAI_LLM_MODEL=qwen2.5:7b-instruct
FORGEAI_LLM_MODEL_VERSION=latest
FORGEAI_LLM_TEMPERATURE=0.1
FORGEAI_LLM_SEED=42
FORGEAI_LLM_MAX_TOKENS=2048
FORGEAI_LLM_TIMEOUT_SECONDS=60.0
FORGEAI_LLM_MAX_RETRIES=3

# Ollama settings (when FORGEAI_LLM_PROVIDER=ollama)
FORGEAI_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible settings (when FORGEAI_LLM_PROVIDER=openai_compat)
FORGEAI_OPENAI_BASE_URL=https://api.openai.com/v1
FORGEAI_OPENAI_API_KEY=

# Pipeline loops, timeouts & budgets (token + latency + cost)
FORGEAI_MAX_IMPROVEMENT_LOOPS=3
FORGEAI_TARGET_EVAL_SCORE=0.9
FORGEAI_STAGE_TIMEOUT_SECONDS=120.0
FORGEAI_MAX_TOKENS_PER_RUN=100000
FORGEAI_MAX_LATENCY_SECONDS_PER_RUN=600.0
FORGEAI_MAX_COST_USD_PER_RUN=2.00
FORGEAI_INPUT_COST_PER_1K=0.0005
FORGEAI_OUTPUT_COST_PER_1K=0.0015

# Storage paths
FORGEAI_DATA_DIR=./data
FORGEAI_DB_PATH=./data/forgeai.db
FORGEAI_ARTIFACTS_DIR=./data/artifacts

# Upload, ingestion & security guards
FORGEAI_MAX_UPLOAD_MB=10
FORGEAI_MAX_FILES_PER_RUN=20
FORGEAI_MAX_CSV_ROWS=5000
FORGEAI_ALLOW_PRIVATE_URLS=false
# Comma-separated host allowlist for runtime http_get tool (empty = tool disabled)
FORGEAI_HTTP_ALLOWED_HOSTS=
FORGEAI_REDACT_PII=true

# Service & Worker settings
FORGEAI_API_HOST=0.0.0.0
FORGEAI_API_PORT=8000
FORGEAI_WORKER_CONCURRENCY=2
FORGEAI_RUN_EMBEDDED_WORKER=true
FORGEAI_API_KEY=

# UI settings
FORGEAI_API_BASE_URL=http://localhost:8000
